# --- Data (keep folders via .gitkeep, never commit raw/large data) ---
data/raw/*
data/processed/*
data/processed_p35/
data/processed_phase4/
data/synthetic/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/synthetic/.gitkeep

# Hand-collected real messages (personal data risk): never commit
data/real_indian/

# --- Model weights / artifacts ---
models/
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.ckpt
*.h5
*.joblib
*.pkl

# --- Experiment tracking / vector stores ---
mlflow.db
mlflow.db-*
mlruns/
mlartifacts/
chroma_db/
.chroma/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Logs ---
*.log

# Phase 4 Colab data pack and returned outputs (models, predictions)
data/*.zip
colab_outputs/

# Real phone screenshots for the manual OCR check (personal data risk): never commit
data/real_screenshots/*
!data/real_screenshots/README.md

# Rendered sample screenshots (regenerable: python -m src.ocr.sample_screenshots)
data/samples/screenshots/

# Staged Hugging Face Space uploads (python -m api.stage_space)
build/

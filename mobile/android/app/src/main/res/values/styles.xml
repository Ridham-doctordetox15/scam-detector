<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark Mode off. Shown while the process starts: the app's background colour with the
         logo (drawable/launch_background.xml). Removed when Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI while it initialises: the same colour as the app's background,
         so nothing flashes between the launch screen and the first frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>

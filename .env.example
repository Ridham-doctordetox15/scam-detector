# Copy this file to .env and fill in your own values. Never commit .env.
# This file must contain placeholders only (a test and a pre-commit hook enforce this).

# LLM explainer / synthetic data generation (free tiers) - use either or both
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the models used for synthetic data generation.
# GEMINI_MODELS is comma-separated; each Gemini model has its own free-tier quota.
# GROQ_MODEL=
# GEMINI_MODELS=

# Optional: override the models used by the Phase 7 LLM explainer (separate from
# the synthetic-data-generation models above - the explainer runs interactively,
# so a fast/cheap model matters more here than for offline batch generation).
# EXPLAINER_GROQ_MODEL=
# EXPLAINER_GEMINI_MODEL=

# Hugging Face (datasets, model hub, Spaces)
HF_TOKEN=your_huggingface_token_here

# Kaggle (dataset download)
KAGGLE_API_TOKEN=your_kaggle_api_token_here

# Supabase (feedback storage, free tier)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_key_here

# PhishTank (offline phishing URL list refresh, Phase 5) - optional, free registration
# at phishtank.org; if signups are closed, refresh_openphish.py needs no key.
PHISHTANK_APP_KEY=your_phishtank_app_key_here
# OCR (Phase 8) - optional overrides. EasyOCR language codes, comma-separated
# (Hindi pairs only with English/Marathi/Nepali). Default: en,hi.
# OCR_LANGUAGES=en,hi
# Screenshot upload size limit in MB. Default: 5.
# OCR_MAX_IMAGE_MB=5

# --- Backend API (Phase 9) - all optional; defaults shown. See docs/deployment.md. ---
# SUPABASE_KEY above must be a SECRET key (sb_secret_...), server-side only - never a frontend.
# SUPABASE_FEEDBACK_TABLE=feedback
# Private Hugging Face model repo holding svm.joblib (used by `python -m api.prefetch`).
# MODEL_REPO_ID=your-username/scam-detector-models
# MODEL_REPO_REVISION=main
# Exact browser origins allowed to call the API, comma-separated. Empty = no cross-origin access.
# Local web dev: http://localhost:3000. Deployed: the web app's origin, e.g. https://your-site.vercel.app
# (The web app's own settings - NEXT_PUBLIC_API_URL etc. - are public build variables set on the
# static host, not here. See docs/deployment.md, "Web frontend".)
# CORS_ORIGINS=
# MAX_TEXT_CHARS=5000
# RATE_LIMIT_TEXT_PER_MIN=20
# RATE_LIMIT_IMAGE_PER_MIN=6
# RATE_LIMIT_FEEDBACK_PER_MIN=30
# Reverse proxies in front of the app (Hugging Face: 1). 0 = ignore X-Forwarded-For.
# TRUSTED_PROXY_HOPS=0
# TEXT_TIMEOUT_S=25
# IMAGE_TIMEOUT_S=45
# MAX_CONCURRENT_ANALYSES=2
# MAX_CONCURRENT_OCR=1
# USE_ONNX_CLASSIFIER=false
# Set to 0 in deployments after prefetching models, so nothing downloads at request time.
# EASYOCR_DOWNLOAD_ENABLED=1
